# System Core Configurations
PORT=5000
NODE_ENV=development

# Database Connections
# For local setup, use standard localhost URI. For cloud, paste your MongoDB Atlas connection string.
MONGO_URI=mongodb://localhost:27017/intellimeet

# JWT Security Signature Keys
JWT_SECRET=supersecret_intellimeet_jwt_key
JWT_EXPIRES_IN=24h

# AI Engine Credentials (Google Gemini & Groq Fallback)
# Get a free API Key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
# Get a free API Key from Groq Console: https://console.groq.com/
GROQ_API_KEY=

# Scheduled Overdue Reminder Notifications (Discord/Slack Webhooks)
# Create a webhook URL in Discord (Channel Settings > Integrations > Webhooks) or Slack.
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Cron Scheduler Expression (Default runs every minute for quick testing)
CRON_SCHEDULE=* * * * *

# Evaluation & Presentation Details (Displayed on GET /api/evaluation)
CANDIDATE_NAME=Full Stack Intern Candidate
CANDIDATE_EMAIL=candidate@example.com
REPOSITORY_URL=https://github.com/candidate/intellimeet
DEPLOYED_URL=http://localhost:5000
